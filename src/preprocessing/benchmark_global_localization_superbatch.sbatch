#!/bin/bash
#SBATCH --job-name=global_q_superbatch
#SBATCH --output=/scratch/ap7151/iclr-paper/ANALYTIC_APPROACH/slurm_logs/%x_%j.out
#SBATCH --error=/scratch/ap7151/iclr-paper/ANALYTIC_APPROACH/slurm_logs/%x_%j.err
#SBATCH --time=02:00:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=128G
#SBATCH --gres=gpu:1
#SBATCH --account=torch_pr_60_general

set -euo pipefail

ROOT=/scratch/ap7151/iclr-paper/ANALYTIC_APPROACH
RUN_PATH=${RUN_PATH:?set RUN_PATH to a completed global-codebook pursuit run}
OUTPUT=${OUTPUT:?set OUTPUT to the benchmark JSON path}

singularity exec --nv --overlay /scratch/${USER}/_ENVS/pytorch.ext3:ro \
    /share/apps/images/cuda12.8.1-cudnn9.8.0-ubuntu24.04.2.sif \
    /bin/bash -c "source /ext3/env.sh && cd $ROOT && python \
        src/preprocessing/benchmark_global_localization_superbatch.py \
        $RUN_PATH $OUTPUT --max-events 2048 \
        --batch-sizes 256 512 1024 2048"
